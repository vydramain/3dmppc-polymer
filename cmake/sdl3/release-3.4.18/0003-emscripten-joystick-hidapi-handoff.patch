+// Called inside the frame: the HIDAPI check may open a pad through WebHID, which needs promising.
 static void EMSCRIPTEN_JoystickDetect(void)
 {
+    SDL_pending_joystick *pending;
+
+    while ((pending = SDL_pending_list) != NULL) {
+        // The check may suspend, and the browser may disconnect the pad meanwhile.
+        const char *name = pending->item->name;
+        bool claimed = !pending->removed &&
+            SDL_JoystickHandledByAnotherDriver(&SDL_EMSCRIPTEN_JoystickDriver, pending->vendor, pending->product, 0, name);
+
+        SDL_pending_list = pending->next;
+        if (claimed || pending->removed) {
+            FreePendingJoystick(pending);
+            continue;
+        }
+
+        if (!SDL_joylist_tail) {
+            SDL_joylist = SDL_joylist_tail = pending->item;
+        } else {
+            SDL_joylist_tail->next = pending->item;
+            SDL_joylist_tail = pending->item;
+        }
+
+        ++numjoysticks;
+
+        SDL_PrivateJoystickAdded(pending->item->device_instance);
+
+#ifdef DEBUG_JOYSTICK
+        SDL_Log("Number of joysticks is %d", numjoysticks);
+#endif
+#ifdef DEBUG_JOYSTICK
+        SDL_Log("Added joystick with index %d", pending->item->index);
+#endif
+
+        SDL_free(pending);
+    }
 }
 
