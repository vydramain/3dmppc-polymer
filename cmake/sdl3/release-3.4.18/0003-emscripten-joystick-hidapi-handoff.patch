 static SDL_joylist_item *SDL_joylist_tail = NULL;
 static int numjoysticks = 0;
 
+// A pad from the browser callback that SDL does not show yet. Detect and Quit free it;
+// disconnect only sets removed, because the HIDAPI check in Detect may suspend.
+typedef struct SDL_pending_joystick
+{
+    SDL_joylist_item *item;
+    Uint16 vendor;
+    Uint16 product;
+    bool removed;
+    struct SDL_pending_joystick *next;
+} SDL_pending_joystick;
+
+// The browser callback runs outside WebAssembly.promising, so it only queues pads.
+static SDL_pending_joystick *SDL_pending_list = NULL;
+
+// Returns the queued pad with this HTML index, or NULL.
+static SDL_pending_joystick *PendingByIndex(int index)
+{
+    SDL_pending_joystick *pending = SDL_pending_list;
+
+    while (pending) {
+        if (!pending->removed && pending->item->index == index) {
+            break;
+        }
+        pending = pending->next;
+    }
+
+    return pending;
+}
+
+static void FreePendingJoystick(SDL_pending_joystick *pending)
+{
+    SDL_free(pending->item->mapping);
+    SDL_free(pending->item->name);
+    SDL_free(pending->item);
+    SDL_free(pending);
+}
